{
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "enabledPlugins": {
    "engineering@knowledge-work-plugins": true,
    "product-management@knowledge-work-plugins": true,
    "design@knowledge-work-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(flutter pub *)",
      "Bash(dart format *)",
      "Bash(flutter analyze *)",
      "Bash(flutter analyze)",
      "Bash(flutter test *)",
      "Bash(flutter test)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./env/*.local.json)"
    ]
  }
}
